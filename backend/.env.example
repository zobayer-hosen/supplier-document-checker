# Copy this file to `.env` and fill in the real values.
# Never commit `.env` to GitHub.

# Which LLM extracts information from the PDFs: openai, gemini or deepseek
LLM_PROVIDER=openai

# OpenAI - extracts information when LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-4.1-mini

# Neon PostgreSQL connection string.
# Copy it from the Neon console and change the start to `postgresql+psycopg://`
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Upload limits
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=100

# How many times to ask the LLM again if its answer has the wrong shape
MAX_EXTRACTION_RETRIES=2

# Folder where uploaded files are stored (local demo only)
UPLOAD_DIRECTORY=uploads

# Frontend address allowed to call this API
CORS_ORIGINS=http://localhost:3000

# DeepSeek on Modal: extracts information when LLM_PROVIDER=deepseek.
# The Modal proxy token is created in the Modal dashboard (Settings > Proxy Auth Tokens).
DEEPSEEK_BASE_URL=https://your-workspace--your-app.modal.run/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_ROUTING_AFFINITY_KEY=

# Gemini: extracts information when LLM_PROVIDER=gemini, and always reads scanned pages (OCR).
# Get a key at https://aistudio.google.com/apikey. Without it, scanned PDFs go to a person.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_OCR_MODEL=gemini-3.6-flash
